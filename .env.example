# Copia questo file in .env.local e aggiungi la tua chiave Google Places
# Le chiavi Apify e RapidAPI le inserisci direttamente nell'app

GOOGLE_PLACES_KEY=AIza...

# Telegram MTProto (my.telegram.org) — lettura gruppi privati, vedi scripts/telegram-*.js
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Turso (libSQL) — storage annunci letti dai gruppi Telegram
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
